# Bitchat Bridge Configuration Example
# Copy this file to .env to use it.

# UUID of the target Bitchat device (iPhone/Mac)
# If left empty, the bridge will scan for devices.
BITCHAT_UUID=

# Nickname for this bridge node
BITCHAT_NICKNAME=MacBridge

# Optional: Manually set Write/Notify UUIDs if auto-discovery fails
# WRITE_UUID=
# NOTIFY_UUID=
